{%- doc -%}
  Renders one clickable hotspot: trigger button ("+") + product popover
  (photo, title, price, quick-add). Extracted from
  blocks/_hotspot-product.liquid so it can be shared between that native
  block (theme-block-driven, one hotspot per block) and
  sections/section-shop-the-look.liquid (metaobject-driven, one hotspot per
  "Look Hotspot" entry) — both get the exact same interaction,
  accessibility and quick-add behavior with zero duplicated logic.

  @param {object} product - The product to show in the popover
  @param {number} x_position - Horizontal position, 0-100 (%)
  @param {number} y_position - Vertical position, 0-100 (%)
  @param {string} [hotspot_color] - Trigger background color
  @param {string} [bullseye_color] - Plus-icon color
  @param {string} [product_title_preset] - Typography preset for the product title
  @param {string} [product_price_preset] - Typography preset for the product price
  @param {string} [dialog_background_color] - Custom popover background color. Text
    contrast is handled automatically via the contrast-override snippet. Blank
    keeps the theme's default popover background.
  @param {object} block - Any object with a unique `.id` (a real theme block, or a
    metaobject entry) — used for the anchor-name and passed through to the
    native `quick-add` snippet, which only ever reads `block.id`.
  @param {string} [shopify_attributes] - `block.shopify_attributes`, when called
    from a real theme block, so the customizer can select it. Omit for
    metaobject-driven (non-block) callers.
  @param {string} section_id - `section.id` of the calling section, passed through
    to the native `quick-add` snippet. `render` gives this snippet its own scope,
    so the caller's `section` isn't reliably available here — passed explicitly
    rather than assumed.

  @example
  {% render 'hotspot-product-content',
    product: product,
    x_position: 40,
    y_position: 60,
    hotspot_color: section.settings.hotspot_color,
    bullseye_color: section.settings.bullseye_color,
    product_title_preset: section.settings.product_title_preset,
    product_price_preset: section.settings.product_price_preset,
    block: block,
    section_id: section.id
  %}
{%- enddoc -%}

{% liquid
  assign placeholder_product_title = 'placeholders.product_title' | t
  assign product_title = product.title | default: placeholder_product_title
  assign dialog_color_id = 'hotspot-dialog-' | append: block.id
%}
{% if dialog_background_color != blank %}
  {% render 'contrast-override',
    background_color: dialog_background_color,
    section_id: dialog_color_id,
    preset: 'ui'
  %}
{% endif %}

<product-hotspot-component
  class="hotspot{% if product == blank and request.design_mode == false %} hotspot--hidden-touch hidden--mobile{% endif %}"
  style="
    left: calc({{ x_position }}% - var(--hotspot-hit-area) / 2);
    top: calc({{ y_position }}% - var(--hotspot-hit-area) / 2);
    --hotspot-bg: {{ hotspot_color }};
    --hotspot-bullseye: {{ bullseye_color }};
  "
  data-product-url="{{ product.url }}"
  data-product-title="{{ product.title | escape }}"
  data-id="{{ block.id }}"
  {{ shopify_attributes }}
>
  <button
    class="hotspot-trigger"
    aria-label="{{ 'accessibility.show_product_details' | t: product_name: product_title }}"
    ref="trigger"
    on:click="/handleHotspotClick"
    style="anchor-name: --hotspot-trigger-{{ block.id }};"
  ></button>
  <dialog
    aria-label="{{ 'accessibility.product_details' | t }}"
    class="hotspot-dialog{% if dialog_background_color != blank %} color-custom-{{ dialog_color_id }}{% endif %}"
    ref="dialog"
  >
    {% if product != blank %}
      <a
        href="{{ product.url }}"
        class="hotspot-dialog__link"
        aria-label="{{ product.title | escape }}"
        ref="productLink"
      >
      </a>
    {% endif %}
    <div class="hotspot-dialog__product">
      {% if product.featured_image != blank %}
        {% render 'image', image: product.featured_image, class: 'hotspot-dialog__product-image' %}
      {% else %}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'hotspot-dialog__placeholder-product-image' }}
      {% endif %}
      <div class="hotspot-dialog__product-content">
        <div class="hotspot-dialog__product-info">
          <h2 class="hotspot-dialog__product-title {{ product_title_preset | default: 'h5' }}">
            {{ product_title }}
          </h2>
          <div class="hotspot-dialog__product-price {{ product_price_preset | default: 'h6' }}">
            {% render 'price', product_resource: product %}
          </div>
        </div>
        {% if product != blank %}
          {% if product.available %}
            {% render 'quick-add', product: product, section_id: section_id, block: block %}
          {% else %}
            <div class="hotspot-dialog__sold-out-badge">
              {{ 'content.product_badge_sold_out' | t }}
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </dialog>
</product-hotspot-component>
