{%- doc -%}
  Metaobject-driven "Shop the Look" section. Reuses the exact same
  interaction/accessibility/mobile behavior as the native
  sections/product-hotspots.liquid (shared snippets: hotspot-styles,
  hotspot-product-content, same product-hotspot.js component) — the only
  difference is hotspots come from a "Look" metaobject's "hotspots" list
  instead of manually-added theme blocks, so a merchant can build one
  reusable "Look" and reference it from multiple sections/pages.
{%- enddoc -%}

<script
  src="{{ 'product-hotspot.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'variant-picker-styles' %}
{% render 'buy-buttons-styles' %}
{% render 'product-badges-styles' %}
{% render 'hotspot-styles' %}

{% style %}
  #shopify-section-{{ section.id }} {
    --hotspot-size: {{ section.settings.hotspot_size }}px;
    --hotspot-plus-thickness: {{ section.settings.hotspot_plus_thickness }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --hotspot-size: {{ section.settings.hotspot_size_mobile }}px;
      --hotspot-plus-thickness: {{ section.settings.hotspot_plus_thickness_mobile }}px;
    }
  }
{% endstyle %}

{% liquid
  assign look = section.settings.look
  assign has_look = false
  if look != blank
    assign has_look = true
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% if has_look or request.design_mode %}
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>

  <div
    class="
      section
      section--{{ section.settings.section_width }}
      section-product-hotspots
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      spacing-style
      gap-style
    "
    data-testid="shop-the-look"
    style="
      {% render 'spacing-style', settings: section.settings %}
      {% render 'gap-style', value: 28 %}
      {% if section.settings.section_height != 'auto' %}
        --ratio: {{ section.settings.section_height }};
      {% elsif look.image.value != blank %}
        --ratio: {{ look.image.value.aspect_ratio }};
      {% endif %}
      --product-title-gap: {{ section.settings.product_title_gap }}px;
      --hotspot-hit-area: {{ section.settings.hotspot_hit_area }}px;
      --minimum-width-dialog: 260px;
      --maximum-width-dialog: 330px;
      --width-product-image-dialog: 110px;
    "
  >
    <div class="section-product-hotspots__wrapper">
      {% if section.settings.heading != blank %}
        <div class="section-product-hotspots__header">
          <p class="{{ section.settings.heading_preset | default: 'h4' }}">{{ section.settings.heading }}</p>
        </div>
      {% endif %}

      {% if has_look %}
        <div class="section-product-hotspots__content">
          {% if section.settings.toggle_overlay %}
            {% render 'overlay', settings: section.settings, layer: 'var(--layer-flat)' %}
          {% endif %}

          {% if look.image.value != blank %}
            {% render 'image', image: look.image.value, class: 'hotspots__background-image' %}
          {% else %}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'hotspots__background-image' }}
          {% endif %}

          <div class="hotspots-container">
            {% for hotspot in look.hotspots.value %}
              {% render 'hotspot-product-content',
                product: hotspot.product.value,
                x_position: hotspot.position_x.value,
                y_position: hotspot.position_y.value,
                hotspot_color: section.settings.hotspot_color,
                bullseye_color: section.settings.bullseye_color,
                product_title_preset: section.settings.product_title_preset,
                product_price_preset: section.settings.product_price_preset,
                dialog_background_color: section.settings.popover_background_color,
                block: hotspot
              %}
            {% endfor %}
          </div>
        </div>
      {% else %}
        <p class="section-shop-the-look__empty-state">
          {{ 'content.shop_the_look_select_prompt' | t }}
        </p>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .section-shop-the-look__empty-state {
    padding: var(--padding-xl);
    text-align: center;
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.shop_the_look",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "metaobject",
      "id": "look",
      "metaobject_type": "look",
      "label": "t:settings.look"
    },
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.shop_the_look_heading"
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "t:settings.size",
      "options": [
        { "value": "", "label": "t:options.default" },
        { "value": "paragraph", "label": "t:options.paragraph" },
        { "value": "h3", "label": "t:options.h3" },
        { "value": "h4", "label": "t:options.h4" },
        { "value": "h5", "label": "t:options.h5" }
      ],
      "default": "h4"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.media_overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        { "value": "solid", "label": "t:options.solid" },
        { "value": "gradient", "label": "t:options.gradient" }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        { "value": "to top", "label": "t:options.up" },
        { "value": "to bottom", "label": "t:options.down" }
      ],
      "default": "to top",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        { "value": "auto", "label": "t:options.auto" },
        { "value": "21 / 9", "label": "t:options.small" },
        { "value": "16 / 9", "label": "t:options.medium" },
        { "value": "4 / 3", "label": "t:options.large" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "range",
      "id": "hotspot_size",
      "label": "t:settings.hotspot_size",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "hotspot_size_mobile",
      "label": "t:settings.hotspot_size_mobile",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "hotspot_plus_thickness",
      "label": "t:settings.hotspot_plus_thickness",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "hotspot_plus_thickness_mobile",
      "label": "t:settings.hotspot_plus_thickness_mobile",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "hotspot_hit_area",
      "label": "t:settings.hotspot_hit_area",
      "info": "t:info.hotspot_hit_area_accessibility",
      "min": 24,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "t:settings.hotspot_color",
      "default": "#FFFFFF57",
      "alpha": true
    },
    {
      "type": "color",
      "id": "bullseye_color",
      "label": "t:settings.bullseye_color",
      "default": "#ffffff",
      "alpha": true
    },
    {
      "type": "color",
      "id": "background_color",
      "placeholder": "t:settings.default",
      "label": "t:settings.background_color"
    },
    {
      "type": "header",
      "content": "t:content.popover"
    },
    {
      "type": "color",
      "id": "popover_background_color",
      "label": "t:settings.popover_background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "product_title_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "product_title_preset",
      "label": "t:settings.product_title_typography",
      "options": [
        { "value": "", "label": "t:options.default" },
        { "value": "paragraph", "label": "t:options.paragraph" },
        { "value": "h4", "label": "t:options.h4" },
        { "value": "h5", "label": "t:options.h5" },
        { "value": "h6", "label": "t:options.h6" }
      ],
      "default": "",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "select",
      "id": "product_price_preset",
      "label": "t:settings.product_price_typography",
      "options": [
        { "value": "", "label": "t:options.default" },
        { "value": "paragraph", "label": "t:options.paragraph" },
        { "value": "h4", "label": "t:options.h4" },
        { "value": "h5", "label": "t:options.h5" },
        { "value": "h6", "label": "t:options.h6" }
      ],
      "default": "",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.shop_the_look",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
